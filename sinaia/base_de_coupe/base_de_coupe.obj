# Base de coupe quadrillee -- plaque plate, quadrillage TEXTURE.
#
# Unite : le MILLIMETRE. Plaque 450 x 300 x 3 mm.
# Quadrillage 42 x 27 cm centre, pas de 1 cm, trait fort tous les 5.
# La texture fait 4500 x 3000 px, soit 10 px/mm : une graduation k
# tombe sur le pixel 150 + 100k, sans arrondi.

mtllib base_de_coupe.mtl
o base_de_coupe
v 0.0000 0.0000 0.0000
v 450.0000 0.0000 0.0000
v 450.0000 300.0000 0.0000
v 0.0000 300.0000 0.0000
v 0.0000 0.0000 3.0000
v 450.0000 0.0000 3.0000
v 450.0000 300.0000 3.0000
v 0.0000 300.0000 3.0000
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 1
vn 0 0 -1
vn 0 -1 0
vn 1 0 0
vn 0 1 0
vn -1 0 0

usemtl dessus
f 5/1/1 6/2/1 7/3/1 8/4/1

usemtl flancs
f 1/1/2 4/2/2 3/3/2 2/4/2
f 1/1/3 2/2/3 6/3/3 5/4/3
f 2/1/4 3/2/4 7/3/4 6/4/4
f 3/1/5 4/2/5 8/3/5 7/4/5
f 4/1/6 1/2/6 5/3/6 8/4/6
