# many_materials.obj -- soixante triangles, un materiau chacun.
#
# UN SEUL OBJET, DONC UN SEUL MAILLAGE PORTEUR DES SOIXANTE MATERIAUX. C'est la
# forme que prend le cas cite par l'hote historique -- un modele a 98 materiaux
# -- et c'est celle qui fait grossir une liste d'images a chaque rechargement.
#
# ASCII PUR, fins de ligne LF.

mtllib many_materials.mtl

