{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "monument-v14",
  "title": "Monument (v14)",
  "description": "Document d'un monument, à la forme de sa source : sections et valeurs du README du monument, chacune avec son unité telle qu'écrite, dans son repère. Écrit par le script d'un monument (src/cgarchi/data/<monument>_from_readme.py, moteur monument_from_readme.py), jamais à la main. Lecteur : ParseMonument (src/cgarchi/classical_monument.h).",
  "$comment": "Règles que ce fichier n'exprime pas, tenues par le lecteur : `value` est requise si et seulement si `status` n'est pas « manquant » ; « lu » et « mesuré » citent au moins une source, « manquant » aucune ; chaque source citée est une clé de `sources`, et chaque clé de `sources` est citée ; `readme` n'est pas vide ; les coordonnées de contrôle sont strictement croissantes ; les deux listes d'un profil de contrôle ont la même longueur, non nulle, et ses profondeurs sont strictement croissantes ; l'unité « ° » est celle des seuls angles (`$defs/angle`, `$defs/angleControl`) ; l'unité « ratio » est celle des seuls rapports (`$defs/ratio`) ; une suite de divisions ou de hauteurs n'est jamais « manquant », et ses deux listes ont la même longueur, non nulle ; un polygone n'est jamais « manquant », ses deux listes `u` et `h` ont la même longueur, au moins 3, et ses coordonnées sont finies et >= 0. Les clés en double sont refusées. Les contrôles du péristyle (`controls`) et de la krépis (`krepisControls`) sont en mètres. Blocs : `krepis`, `peristyle`, `columns`, `entablature`, `pediment`, `cella`, `interior`, `epicranitis`, `porchExtension`, `eastCeiling` et `flankCeilings` sont facultatifs ; un bloc absent est une partie non documentée, un bloc présent porte toutes ses clés. Les blocs de contrôle et leur partie sont liés par `dependentRequired`, de même que l'intérieur et l'épicranitis et la cella qui les porte, le prolongement est et l'épicranitis dont il continue le couronnement, le plafond est et le prolongement qui le porte, et les plafonds des flancs et le plafond est.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "monument", "source", "sources"],
  "dependentRequired": {
    "peristyle": ["controls"], "controls": ["peristyle"], "krepisControls": ["krepis"], "columnControls": ["columns"],
    "entablatureControls": ["entablature"], "pedimentControls": ["pediment"], "cellaControls": ["cella"],
    "interior": ["cella"], "interiorControls": ["interior"], "epicranitis": ["cella"],
    "epicranitisControls": ["epicranitis"], "porchExtension": ["epicranitis"],
    "porchExtensionControls": ["porchExtension"], "eastCeiling": ["porchExtension"],
    "eastCeilingControls": ["eastCeiling"], "flankCeilings": ["eastCeiling"],
    "flankCeilingsControls": ["flankCeilings"]
  },
  "properties": {
    "schema":   { "const": "monument/v14" },
    "monument": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "sha256", "bytes", "derivedBy"],
      "properties": {
        "document":  { "type": "string", "description": "Chemin du README, relatif à la racine des documents de l'utilisateur." },
        "sha256":    { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes":     { "type": "integer", "exclusiveMinimum": 0 },
        "derivedBy": { "type": "string" }
      }
    },
    "sources": {
      "type": "object",
      "description": "Références citées par les valeurs : identifiant du README (« D », « S »...) vers son libellé.",
      "additionalProperties": { "type": "string" }
    },
    "krepis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stylobateWidth", "stylobateLength", "stepCount", "stylobateHeight", "secondStepHeight",
                   "thirdStepHeight", "secondStepTread", "thirdStepTread", "cornerMargin", "euthynteriaHeight",
                   "euthynteriaTread"],
      "properties": {
        "stylobateWidth":   { "$ref": "#/$defs/length" },
        "stylobateLength":  { "$ref": "#/$defs/length" },
        "stepCount":        { "$ref": "#/$defs/count" },
        "stylobateHeight":  { "$ref": "#/$defs/length" },
        "secondStepHeight": { "$ref": "#/$defs/length" },
        "thirdStepHeight":  { "$ref": "#/$defs/length" },
        "secondStepTread":  { "$ref": "#/$defs/length" },
        "thirdStepTread":   { "$ref": "#/$defs/length" },
        "cornerMargin":     { "$ref": "#/$defs/length" },
        "euthynteriaHeight": { "$ref": "#/$defs/length" },
        "euthynteriaTread":  { "$ref": "#/$defs/length" }
      }
    },
    "peristyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontColumns", "flankColumns", "frontSpacing", "flankSpacing", "frontCornerSpacing",
                   "flankCornerSpacing"],
      "properties": {
        "frontColumns":       { "$ref": "#/$defs/count" },
        "flankColumns":       { "$ref": "#/$defs/count" },
        "frontSpacing":       { "$ref": "#/$defs/length" },
        "flankSpacing":       { "$ref": "#/$defs/length" },
        "frontCornerSpacing": { "$ref": "#/$defs/length" },
        "flankCornerSpacing": { "$ref": "#/$defs/length" }
      }
    },
    "columns": {
      "type": "object",
      "description": "README sections 4.1, 4.4 et 5 : la colonne. Retraits de l'échine et des annelets depuis le nu de l'abaque, profondeurs sous le lit de l'abaque.",
      "additionalProperties": false,
      "required": ["lowerDiameter", "cornerLowerDiameter", "upperDiameter", "height", "fluteCount", "fluteDepth",
                   "entasisSagitta", "entasisHeight", "abacusHeight", "abacusHalfWidth", "echinusHeight",
                   "echinusJunctionDepth", "echinusJunctionRetreat", "echinusTopRetreat", "echinusLipRadius",
                   "annuletCount", "annuletsHeight", "annuletsTopRetreat", "annuletsBottomRetreat",
                   "hypotrachelionHeight", "grooveHeight", "grooveDepth"],
      "properties": {
        "lowerDiameter":          { "$ref": "#/$defs/length" },
        "cornerLowerDiameter":    { "$ref": "#/$defs/length" },
        "upperDiameter":          { "$ref": "#/$defs/length" },
        "height":                 { "$ref": "#/$defs/length" },
        "fluteCount":             { "$ref": "#/$defs/count" },
        "fluteDepth":             { "$ref": "#/$defs/length" },
        "entasisSagitta":         { "$ref": "#/$defs/length" },
        "entasisHeight":          { "$ref": "#/$defs/length" },
        "abacusHeight":           { "$ref": "#/$defs/length" },
        "abacusHalfWidth":        { "$ref": "#/$defs/length" },
        "echinusHeight":          { "$ref": "#/$defs/length" },
        "echinusJunctionDepth":   { "$ref": "#/$defs/length" },
        "echinusJunctionRetreat": { "$ref": "#/$defs/length" },
        "echinusTopRetreat":      { "$ref": "#/$defs/length" },
        "echinusLipRadius":       { "$ref": "#/$defs/length" },
        "annuletCount":           { "$ref": "#/$defs/count" },
        "annuletsHeight":         { "$ref": "#/$defs/length" },
        "annuletsTopRetreat":     { "$ref": "#/$defs/length" },
        "annuletsBottomRetreat":  { "$ref": "#/$defs/length" },
        "hypotrachelionHeight":   { "$ref": "#/$defs/length" },
        "grooveHeight":           { "$ref": "#/$defs/length" },
        "grooveDepth":            { "$ref": "#/$defs/length" }
      }
    },
    "controls": {
      "type": "object",
      "description": "Résultats imprimés par le README, relus et recalculés par les tests ; sans statut ; en mètres.",
      "additionalProperties": false,
      "required": ["frontAxesY", "flankAxesX"],
      "properties": {
        "frontAxesY": { "$ref": "#/$defs/axes" },
        "flankAxesX": { "$ref": "#/$defs/axes" },
        "frontSum":   { "$ref": "#/$defs/result" },
        "flankSum":   { "$ref": "#/$defs/result" }
      }
    },
    "krepisControls": {
      "type": "object",
      "description": "Emprise de l'euthyntéria imprimée par le README (contrôles), sans statut ; en mètres.",
      "additionalProperties": false,
      "required": ["footprintWidth", "footprintLength"],
      "properties": {
        "footprintWidth":  { "$ref": "#/$defs/result" },
        "footprintLength": { "$ref": "#/$defs/result" }
      }
    },
    "columnControls": {
      "type": "object",
      "description": "Contrôles de la colonne imprimés par le README, chacun avec son unité, relus et recalculés par les tests ; sans statut.",
      "additionalProperties": false,
      "required": ["shaftHeight", "footFluteChord", "fluteCentralRadius", "fluteLateralRadius", "topFluteDepth",
                   "cornerFluteChord", "cornerFluteDepth", "capitalHeight", "annuletsAndRelief", "upperRadius",
                   "echinusLipRetreat", "echinusProfile"],
      "properties": {
        "shaftHeight":        { "$ref": "#/$defs/control" },
        "footFluteChord":     { "$ref": "#/$defs/control" },
        "fluteCentralRadius": { "$ref": "#/$defs/control" },
        "fluteLateralRadius": { "$ref": "#/$defs/control" },
        "topFluteDepth":      { "$ref": "#/$defs/control" },
        "cornerFluteChord":   { "$ref": "#/$defs/control" },
        "cornerFluteDepth":   { "$ref": "#/$defs/control" },
        "capitalHeight":      { "$ref": "#/$defs/control" },
        "annuletsAndRelief":  { "$ref": "#/$defs/control" },
        "upperRadius":        { "$ref": "#/$defs/control" },
        "echinusLipRetreat":  { "$ref": "#/$defs/control" },
        "echinusProfile":     { "$ref": "#/$defs/profile" }
      }
    },
    "entablature": {
      "type": "object",
      "description": "README sections 6.1 à 6.4 : l'entablement du péristyle, regulae, gouttes des regulae, mutules, sous-face inclinée du géison et gouttes des mutules compris (diamètres et vides des têtes, du devant vers le dos ; évasement du pied en diamètre). Hauteurs de bas en haut ; saillies depuis la ligne des axes des colonnes. Une cote en pieds et pouces est une seule valeur d'unité « ft+in ».",
      "additionalProperties": false,
      "required": ["architraveHeight", "taeniaHeight", "regulaHeight", "guttaeHeight", "architraveFaceHeight",
                   "friezeHeight", "triglyphCapitalHeight", "corniceHeight", "mutulePlateHeight", "dripHeight",
                   "coronaHeight", "filletHeight", "crownHeight", "architraveTopProjection", "architraveFootProjection",
                   "taeniaProjection", "triglyphFace", "triglyphCapitalBandProjection",
                   "triglyphCapitalListelProjection", "triglyphCapitalListelHeight", "triglyphCapitalBandHeight",
                   "metopeFace", "mutulePlateProjection", "dripProjection", "coronaProjection", "filletProjection",
                   "crownProjection", "innerFace", "triglyphWidth", "metopeWidth", "triglyphDivisions", "channelDepth",
                   "regulaProjection", "regulaGuttaCount", "regulaGuttaDiameter", "regulaGuttaGap",
                   "regulaGuttaTopProjection", "regulaGuttaFootProjection", "mutuleWidth", "mutuleDepth",
                   "soffitSlope", "mutuleGuttaFrontDiameter", "mutuleGuttaMiddleDiameter", "mutuleGuttaRearDiameter",
                   "mutuleGuttaFrontGap", "mutuleGuttaRearGap", "mutuleGuttaHeight", "mutuleGuttaEdgeAxis",
                   "mutuleGuttaPerRow", "mutuleGuttaFootFlare"],
      "properties": {
        "architraveHeight":                { "$ref": "#/$defs/length" },
        "taeniaHeight":                    { "$ref": "#/$defs/length" },
        "regulaHeight":                    { "$ref": "#/$defs/length" },
        "guttaeHeight":                    { "$ref": "#/$defs/length" },
        "architraveFaceHeight":            { "$ref": "#/$defs/length" },
        "friezeHeight":                    { "$ref": "#/$defs/length" },
        "triglyphCapitalHeight":           { "$ref": "#/$defs/length" },
        "corniceHeight":                   { "$ref": "#/$defs/length" },
        "mutulePlateHeight":               { "$ref": "#/$defs/length" },
        "dripHeight":                      { "$ref": "#/$defs/length" },
        "coronaHeight":                    { "$ref": "#/$defs/length" },
        "filletHeight":                    { "$ref": "#/$defs/length" },
        "crownHeight":                     { "$ref": "#/$defs/length" },
        "architraveTopProjection":         { "$ref": "#/$defs/length" },
        "architraveFootProjection":        { "$ref": "#/$defs/length" },
        "taeniaProjection":                { "$ref": "#/$defs/length" },
        "triglyphFace":                    { "$ref": "#/$defs/length" },
        "triglyphCapitalBandProjection":   { "$ref": "#/$defs/length" },
        "triglyphCapitalListelProjection": { "$ref": "#/$defs/length" },
        "triglyphCapitalListelHeight":     { "$ref": "#/$defs/length" },
        "triglyphCapitalBandHeight":       { "$ref": "#/$defs/length" },
        "metopeFace":                      { "$ref": "#/$defs/length" },
        "mutulePlateProjection":           { "$ref": "#/$defs/length" },
        "dripProjection":                  { "$ref": "#/$defs/length" },
        "coronaProjection":                { "$ref": "#/$defs/length" },
        "filletProjection":                { "$ref": "#/$defs/length" },
        "crownProjection":                 { "$ref": "#/$defs/length" },
        "innerFace":                       { "$ref": "#/$defs/length" },
        "triglyphWidth":                   { "$ref": "#/$defs/length" },
        "metopeWidth":                     { "$ref": "#/$defs/length" },
        "triglyphDivisions":               { "$ref": "#/$defs/divisions" },
        "channelDepth":                    { "$ref": "#/$defs/length" },
        "regulaProjection":                { "$ref": "#/$defs/length" },
        "regulaGuttaCount":                { "$ref": "#/$defs/count" },
        "regulaGuttaDiameter":             { "$ref": "#/$defs/length" },
        "regulaGuttaGap":                  { "$ref": "#/$defs/length" },
        "regulaGuttaTopProjection":        { "$ref": "#/$defs/length" },
        "regulaGuttaFootProjection":       { "$ref": "#/$defs/length" },
        "mutuleWidth":                     { "$ref": "#/$defs/length" },
        "mutuleDepth":                     { "$ref": "#/$defs/length" },
        "soffitSlope":                     { "$ref": "#/$defs/angle" },
        "mutuleGuttaFrontDiameter":        { "$ref": "#/$defs/length" },
        "mutuleGuttaMiddleDiameter":       { "$ref": "#/$defs/length" },
        "mutuleGuttaRearDiameter":         { "$ref": "#/$defs/length" },
        "mutuleGuttaFrontGap":             { "$ref": "#/$defs/length" },
        "mutuleGuttaRearGap":              { "$ref": "#/$defs/length" },
        "mutuleGuttaHeight":               { "$ref": "#/$defs/length" },
        "mutuleGuttaEdgeAxis":             { "$ref": "#/$defs/length" },
        "mutuleGuttaPerRow":               { "$ref": "#/$defs/count" },
        "mutuleGuttaFootFlare":            { "$ref": "#/$defs/length" }
      }
    },
    "entablatureControls": {
      "type": "object",
      "description": "Contrôles de l'entablement imprimés par le README, chacun avec son unité, relus et recalculés par les tests ; sans statut. Angle de la frise (README §6.3) : première solution, celle du modèle (centre du triglyphe d'angle au-delà de l'axe, distance d'angle de façade, métopes d'angle, décalage de l'intermédiaire), puis seconde solution (intermédiaire au milieu de la travée : métopes intérieure et extérieure, façade et flanc). Gouttes des regulae (README §6.1, §6.4) : marge de chaque bout, reste de la largeur de la regula, nombre ; dos des mutules depuis l'axe (README §6.4). Gouttes des mutules (README §6.4) : rangs, diviseur du pas, axes des rangs du milieu et de l'arrière, pas en largeur, évasement en rayon, sa valeur non arrondie et l'avant du pied ; profondeur sous la pente : marge arrière, projection horizontale, dos ; sous-face du géison : cotes du pivot, de l'arête avant-haute, du dessous au dos et du haut du bec, montée, ressaut au dos, saillie du pivot.",
      "additionalProperties": false,
      "required": ["total", "corniceSum", "triglyphDivisionSum", "frontMetope", "flankMetope", "metopeCount",
                   "frontTriglyphs", "flankTriglyphs", "channelBottom", "metopeRecess", "cornerTriglyphOffset",
                   "frontCornerDistance", "frontCornerMetope", "flankCornerMetope", "intermediateShift",
                   "frontMidBayInnerMetope", "frontMidBayOuterMetope", "flankMidBayInnerMetope",
                   "flankMidBayOuterMetope", "regulaGuttaMargin", "regulaGuttaShortfall", "regulaGuttaCountCheck",
                   "mutuleBack",
                   "mutuleGuttaRows", "mutuleGuttaPitchCount", "mutuleGuttaMiddleAxis", "mutuleGuttaRearAxis",
                   "mutuleGuttaPitch", "mutuleRearMargin", "mutuleHorizontalDepth", "mutuleInclinedBack",
                   "soffitPivotZ", "mutuleFrontTopZ", "soffitBackZ", "soffitRise", "geisonBackStep", "dripTopZ",
                   "soffitPivotProjection", "mutuleGuttaRadialFlare", "mutuleGuttaRadialFlareExact",
                   "mutuleGuttaFrontFootProjection"],
      "properties": {
        "total":               { "$ref": "#/$defs/control" },
        "corniceSum":          { "$ref": "#/$defs/control" },
        "triglyphDivisionSum": { "$ref": "#/$defs/control" },
        "frontMetope":         { "$ref": "#/$defs/control" },
        "flankMetope":         { "$ref": "#/$defs/control" },
        "metopeCount":         { "$ref": "#/$defs/countControl" },
        "frontTriglyphs":      { "$ref": "#/$defs/countControl" },
        "flankTriglyphs":      { "$ref": "#/$defs/countControl" },
        "channelBottom":       { "$ref": "#/$defs/control" },
        "metopeRecess":        { "$ref": "#/$defs/control" },
        "cornerTriglyphOffset":   { "$ref": "#/$defs/control" },
        "frontCornerDistance":    { "$ref": "#/$defs/control" },
        "frontCornerMetope":      { "$ref": "#/$defs/control" },
        "flankCornerMetope":      { "$ref": "#/$defs/control" },
        "intermediateShift":      { "$ref": "#/$defs/control" },
        "frontMidBayInnerMetope": { "$ref": "#/$defs/control" },
        "frontMidBayOuterMetope": { "$ref": "#/$defs/control" },
        "flankMidBayInnerMetope": { "$ref": "#/$defs/control" },
        "flankMidBayOuterMetope": { "$ref": "#/$defs/control" },
        "regulaGuttaMargin":      { "$ref": "#/$defs/control" },
        "regulaGuttaShortfall":   { "$ref": "#/$defs/control" },
        "regulaGuttaCountCheck":  { "$ref": "#/$defs/countControl" },
        "mutuleBack":             { "$ref": "#/$defs/control" },
        "mutuleGuttaRows":        { "$ref": "#/$defs/countControl" },
        "mutuleGuttaPitchCount":  { "$ref": "#/$defs/countControl" },
        "mutuleGuttaMiddleAxis":  { "$ref": "#/$defs/control" },
        "mutuleGuttaRearAxis":    { "$ref": "#/$defs/control" },
        "mutuleGuttaPitch":       { "$ref": "#/$defs/control" },
        "mutuleRearMargin":       { "$ref": "#/$defs/control" },
        "mutuleHorizontalDepth":  { "$ref": "#/$defs/control" },
        "mutuleInclinedBack":     { "$ref": "#/$defs/control" },
        "soffitPivotZ":           { "$ref": "#/$defs/control" },
        "mutuleFrontTopZ":        { "$ref": "#/$defs/control" },
        "soffitBackZ":            { "$ref": "#/$defs/control" },
        "soffitRise":             { "$ref": "#/$defs/control" },
        "geisonBackStep":         { "$ref": "#/$defs/control" },
        "dripTopZ":               { "$ref": "#/$defs/control" },
        "soffitPivotProjection":  { "$ref": "#/$defs/control" },
        "mutuleGuttaRadialFlare": { "$ref": "#/$defs/control" },
        "mutuleGuttaRadialFlareExact": { "$ref": "#/$defs/control" },
        "mutuleGuttaFrontFootProjection": { "$ref": "#/$defs/control" }
      }
    },
    "pediment": {
      "type": "object",
      "description": "Fronton (README §9) : hauteur, du dessus de la corniche horizontale au haut de la corniche rampante dans l'axe, en pieds et pouces ; pente 1 : r du haut de la corniche rampante (r, rapport) ; saillie de la corniche rampante depuis le nu du tympan, en pieds et pouces ; nu du tympan depuis l'axe des colonnes de la façade ; hauteurs normales des membres, de haut en bas ; section de la corniche rampante (u depuis le nu du tympan, h normale à la pente) ; sima, acrotères et tuiles.",
      "additionalProperties": false,
      "required": ["apexRise", "rakingRun", "rakingProjection", "tympanumFace", "rakingHeights", "rakingSection", "sima"],
      "properties": {
        "apexRise":           { "$ref": "#/$defs/length" },
        "rakingRun":          { "$ref": "#/$defs/ratio" },
        "rakingProjection":   { "$ref": "#/$defs/length" },
        "tympanumFace":       { "$ref": "#/$defs/length" },
        "rakingHeights":      { "$ref": "#/$defs/rakingHeights" },
        "rakingSection":      { "$ref": "#/$defs/polygon" },
        "sima":               { "$ref": "#/$defs/length" }
      }
    },
    "pedimentControls": {
      "type": "object",
      "description": "Contrôles du fronton imprimés par le README (§9), chacun avec son unité, recalculés par les tests ; sans statut : hauteur du fronton, pente en degrés, pied du haut de la corniche rampante sur le dessus de la corniche horizontale ; hauteur de la corniche rampante, normale puis verticale ; saillie, nu du tympan ; saillies du listel, du larmier et du filet du bas ; écart des larmiers.",
      "additionalProperties": false,
      "required": ["apexRise", "rakingSlope", "eaveHalfSpan", "rakingHeight", "rakingHeightM", "rakingVerticalHeight",
                   "rakingVerticalHeightM", "rakingProjection", "tympanumFaceM", "rakingListelProjection",
                   "rakingCoronaProjection", "rakingBottomFilletProjection", "rakingCoronaGap"],
      "properties": {
        "apexRise":                     { "$ref": "#/$defs/control" },
        "rakingSlope":                  { "$ref": "#/$defs/angleControl" },
        "eaveHalfSpan":                 { "$ref": "#/$defs/control" },
        "rakingHeight":                 { "$ref": "#/$defs/control" },
        "rakingHeightM":                { "$ref": "#/$defs/control" },
        "rakingVerticalHeight":         { "$ref": "#/$defs/control" },
        "rakingVerticalHeightM":        { "$ref": "#/$defs/control" },
        "rakingProjection":             { "$ref": "#/$defs/control" },
        "tympanumFaceM":                { "$ref": "#/$defs/control" },
        "rakingListelProjection":       { "$ref": "#/$defs/control" },
        "rakingCoronaProjection":       { "$ref": "#/$defs/control" },
        "rakingBottomFilletProjection": { "$ref": "#/$defs/control" },
        "rakingCoronaGap":              { "$ref": "#/$defs/control" }
      }
    },
    "cella": {
      "type": "object",
      "description": "Cella et porches (README section 7.8) : longueurs de segments, sans signe, depuis les faces et les bords nommés par le README ; les coordonnées signées sont des contrôles (`cellaControls`).",
      "additionalProperties": false,
      "required": ["toichobateRise", "pteronEast", "pteronWest", "toichobateOverhang", "longWallThickness", "longWallSpan", "wallTop", "eastCrossWallPosition", "eastCrossWallThickness", "westCrossWallPosition", "westCrossWallThickness", "doorWidth", "lintelHeight", "doorJambOffset", "thresholdLength", "thresholdProjection", "thresholdDepth", "naosFloorHeight", "eastAntaRetreat", "westAntaRetreat", "antaInnerProjection", "antaOuterProjection", "antaHeadLength", "porchColumnDiameter", "porchColumnHeight", "porchColumnOffset", "pronaosColumnAxis", "opisthodomosColumnAxis", "porchArchitraveHeight", "porchFriezeHeight", "porchEntablatureDepth", "porchEntablatureFront"],
      "properties": {
        "toichobateRise":         { "$ref": "#/$defs/length" },
        "pteronEast":             { "$ref": "#/$defs/length" },
        "pteronWest":             { "$ref": "#/$defs/length" },
        "toichobateOverhang":     { "$ref": "#/$defs/length" },
        "longWallThickness":      { "$ref": "#/$defs/length" },
        "longWallSpan":           { "$ref": "#/$defs/length" },
        "wallTop":                { "$ref": "#/$defs/length" },
        "eastCrossWallPosition":  { "$ref": "#/$defs/length" },
        "eastCrossWallThickness": { "$ref": "#/$defs/length" },
        "westCrossWallPosition":  { "$ref": "#/$defs/length" },
        "westCrossWallThickness": { "$ref": "#/$defs/length" },
        "doorWidth":              { "$ref": "#/$defs/length" },
        "lintelHeight":           { "$ref": "#/$defs/length" },
        "doorJambOffset":         { "$ref": "#/$defs/length" },
        "thresholdLength":        { "$ref": "#/$defs/length" },
        "thresholdProjection":    { "$ref": "#/$defs/length" },
        "thresholdDepth":         { "$ref": "#/$defs/length" },
        "naosFloorHeight":        { "$ref": "#/$defs/length" },
        "eastAntaRetreat":        { "$ref": "#/$defs/length" },
        "westAntaRetreat":        { "$ref": "#/$defs/length" },
        "antaInnerProjection":    { "$ref": "#/$defs/length" },
        "antaOuterProjection":    { "$ref": "#/$defs/length" },
        "antaHeadLength":         { "$ref": "#/$defs/length" },
        "porchColumnDiameter":    { "$ref": "#/$defs/length" },
        "porchColumnHeight":      { "$ref": "#/$defs/length" },
        "porchColumnOffset":      { "$ref": "#/$defs/length" },
        "pronaosColumnAxis":      { "$ref": "#/$defs/length" },
        "opisthodomosColumnAxis": { "$ref": "#/$defs/length" },
        "porchArchitraveHeight":  { "$ref": "#/$defs/length" },
        "porchFriezeHeight":      { "$ref": "#/$defs/length" },
        "porchEntablatureDepth":  { "$ref": "#/$defs/length" },
        "porchEntablatureFront":  { "$ref": "#/$defs/length" }
      }
    },
    "cellaControls": {
      "type": "object",
      "description": "Contrôles de la cella (README section 7.8, règle R13 du script) : coordonnées signées et cotes, en mètres, sans statut.",
      "additionalProperties": false,
      "required": ["toichobateBottomZ", "toichobateEastX", "toichobateWestX", "toichobateWidth", "longWallInnerY", "longWallOuterY", "longWallLength", "eastCrossWallEastX", "eastCrossWallWestX", "westCrossWallWestX", "westCrossWallEastX", "naosLength", "doorLintelZ", "eastAntaX", "westAntaX", "antaInnerY", "antaFaceWidth", "porchArchitraveBottomZ", "porchArchitraveTopZ", "porchFriezeTopZ"],
      "properties": {
        "toichobateBottomZ":      { "$ref": "#/$defs/result" },
        "toichobateEastX":        { "$ref": "#/$defs/result" },
        "toichobateWestX":        { "$ref": "#/$defs/result" },
        "toichobateWidth":        { "$ref": "#/$defs/result" },
        "longWallInnerY":         { "$ref": "#/$defs/result" },
        "longWallOuterY":         { "$ref": "#/$defs/result" },
        "longWallLength":         { "$ref": "#/$defs/result" },
        "eastCrossWallEastX":     { "$ref": "#/$defs/result" },
        "eastCrossWallWestX":     { "$ref": "#/$defs/result" },
        "westCrossWallWestX":     { "$ref": "#/$defs/result" },
        "westCrossWallEastX":     { "$ref": "#/$defs/result" },
        "naosLength":             { "$ref": "#/$defs/result" },
        "doorLintelZ":            { "$ref": "#/$defs/result" },
        "eastAntaX":              { "$ref": "#/$defs/result" },
        "westAntaX":              { "$ref": "#/$defs/result" },
        "antaInnerY":             { "$ref": "#/$defs/result" },
        "antaFaceWidth":          { "$ref": "#/$defs/result" },
        "porchArchitraveBottomZ": { "$ref": "#/$defs/result" },
        "porchArchitraveTopZ":    { "$ref": "#/$defs/result" },
        "porchFriezeTopZ":        { "$ref": "#/$defs/result" }
      }
    },
    "interior": {
      "type": "object",
      "description": "Intérieur du naos (README section 7.9) : longueurs de segments, sans signe, depuis les nus du naos de la section 7.8, et cotes z depuis le dessus du stylobate ; les coordonnées signées et les cotes déduites sont des contrôles (`interiorControls`). Demande le bloc `cella`.",
      "additionalProperties": false,
      "required": ["spacing", "eastAxisOffset", "westAxisOffset", "wallAxisOffset", "naveLevel", "lowerColumnHeight", "lowerColumnLowerDiameter", "lowerColumnUpperDiameter", "lowerCapitalHeight", "lowerAbacus", "lowerEpistyleHeight", "lowerEpistyleSoffit", "upperColumnHeight", "upperColumnLowerDiameter", "upperColumnUpperDiameter", "upperCapitalHeight", "upperAbacus", "fluteCount", "upperEpistyleHeight", "upperEpistyleSoffit", "courseHeight", "courseThickness", "corniceHeight", "corniceProjection", "pocketCeiling", "pocketMargin"],
      "properties": {
        "spacing":                  { "$ref": "#/$defs/length" },
        "eastAxisOffset":           { "$ref": "#/$defs/length" },
        "westAxisOffset":           { "$ref": "#/$defs/length" },
        "wallAxisOffset":           { "$ref": "#/$defs/length" },
        "naveLevel":                { "$ref": "#/$defs/length" },
        "lowerColumnHeight":        { "$ref": "#/$defs/length" },
        "lowerColumnLowerDiameter": { "$ref": "#/$defs/length" },
        "lowerColumnUpperDiameter": { "$ref": "#/$defs/length" },
        "lowerCapitalHeight":       { "$ref": "#/$defs/length" },
        "lowerAbacus":              { "$ref": "#/$defs/length" },
        "lowerEpistyleHeight":      { "$ref": "#/$defs/length" },
        "lowerEpistyleSoffit":      { "$ref": "#/$defs/length" },
        "upperColumnHeight":        { "$ref": "#/$defs/length" },
        "upperColumnLowerDiameter": { "$ref": "#/$defs/length" },
        "upperColumnUpperDiameter": { "$ref": "#/$defs/length" },
        "upperCapitalHeight":       { "$ref": "#/$defs/length" },
        "upperAbacus":              { "$ref": "#/$defs/length" },
        "fluteCount":               { "$ref": "#/$defs/count" },
        "upperEpistyleHeight":      { "$ref": "#/$defs/length" },
        "upperEpistyleSoffit":      { "$ref": "#/$defs/length" },
        "courseHeight":             { "$ref": "#/$defs/length" },
        "courseThickness":          { "$ref": "#/$defs/length" },
        "corniceHeight":            { "$ref": "#/$defs/length" },
        "corniceProjection":        { "$ref": "#/$defs/length" },
        "pocketCeiling":            { "$ref": "#/$defs/length" },
        "pocketMargin":             { "$ref": "#/$defs/length" }
      }
    },
    "interiorControls": {
      "type": "object",
      "description": "Contrôles de l'intérieur (README section 7.9, règle R13 du script) : coordonnées signées et cotes, en mètres, sans statut.",
      "additionalProperties": false,
      "required": ["eastWallX", "flankAxis1X", "flankAxis2X", "flankAxis3X", "flankAxis4X", "flankAxis5X", "westAxisX", "westWallX", "naosLength", "lateralAxisY", "lowerAbacusTopZ", "lowerEpistyleTopZ", "upperAbacusTopZ", "upperEpistyleTopZ", "courseTopZ", "corniceTopZ", "pocketBottomZ", "pocketEastX", "pocketWestX", "pocketHalfWidthY"],
      "properties": {
        "eastWallX":         { "$ref": "#/$defs/result" },
        "flankAxis1X":       { "$ref": "#/$defs/result" },
        "flankAxis2X":       { "$ref": "#/$defs/result" },
        "flankAxis3X":       { "$ref": "#/$defs/result" },
        "flankAxis4X":       { "$ref": "#/$defs/result" },
        "flankAxis5X":       { "$ref": "#/$defs/result" },
        "westAxisX":         { "$ref": "#/$defs/result" },
        "westWallX":         { "$ref": "#/$defs/result" },
        "naosLength":        { "$ref": "#/$defs/result" },
        "lateralAxisY":      { "$ref": "#/$defs/result" },
        "lowerAbacusTopZ":   { "$ref": "#/$defs/result" },
        "lowerEpistyleTopZ": { "$ref": "#/$defs/result" },
        "upperAbacusTopZ":   { "$ref": "#/$defs/result" },
        "upperEpistyleTopZ": { "$ref": "#/$defs/result" },
        "courseTopZ":        { "$ref": "#/$defs/result" },
        "corniceTopZ":       { "$ref": "#/$defs/result" },
        "pocketBottomZ":     { "$ref": "#/$defs/result" },
        "pocketEastX":       { "$ref": "#/$defs/result" },
        "pocketWestX":       { "$ref": "#/$defs/result" },
        "pocketHalfWidthY":  { "$ref": "#/$defs/result" }
      }
    },
    "epicranitis": {
      "type": "object",
      "description": "Assise XVII extérieure : épicranitis des murs et couronnement de la frise des porches (README section 7.10) : hauteur sur le dessus des murs, face intérieure depuis le nu intérieur des murs du naos, hauteurs du listel et du filet, saillies du listel et de la bande à méandre sur le nu. Demande le bloc `cella`.",
      "additionalProperties": false,
      "required": ["height", "innerOffset", "listelHeight", "filletHeight", "listelProjection", "bandProjection"],
      "properties": {
        "height":           { "$ref": "#/$defs/length" },
        "innerOffset":      { "$ref": "#/$defs/length" },
        "listelHeight":     { "$ref": "#/$defs/length" },
        "filletHeight":     { "$ref": "#/$defs/length" },
        "listelProjection": { "$ref": "#/$defs/length" },
        "bandProjection":   { "$ref": "#/$defs/length" }
      }
    },
    "epicranitisControls": {
      "type": "object",
      "description": "Contrôles du couronnement (README section 7.10, règle R13 du script) : dessus commun, dessous et hauteur du couronnement de la frise des porches, face intérieure et nus des bandes à méandre, en mètres, sans statut.",
      "additionalProperties": false,
      "required": ["topZ", "porchCrownBottomZ", "porchCrownHeight", "innerFaceY", "wallBandY", "eastBandX", "westBandX"],
      "properties": {
        "topZ":              { "$ref": "#/$defs/result" },
        "porchCrownBottomZ": { "$ref": "#/$defs/result" },
        "porchCrownHeight":  { "$ref": "#/$defs/result" },
        "innerFaceY":        { "$ref": "#/$defs/result" },
        "wallBandY":         { "$ref": "#/$defs/result" },
        "eastBandX":         { "$ref": "#/$defs/result" },
        "westBandX":         { "$ref": "#/$defs/result" }
      }
    },
    "porchExtension": {
      "type": "object",
      "description": "Prolongement est de l'entablement des porches au-dessus des portiques latéraux (README section 7.10) : longueur par côté, des faces extérieures des antes à la face intérieure de l'entablement du péristyle (contrôle de fermeture). Demande le bloc `epicranitis`.",
      "additionalProperties": false,
      "required": ["eastSpan"],
      "properties": {
        "eastSpan": { "$ref": "#/$defs/length" }
      }
    },
    "porchExtensionControls": {
      "type": "object",
      "description": "Contrôles du prolongement est (README section 7.10, règle R13 du script) : face intérieure de l'entablement du péristyle et dessous de l'architrave prolongée, en mètres, sans statut.",
      "additionalProperties": false,
      "required": ["ringInnerY", "architraveFootZ"],
      "properties": {
        "ringInnerY":      { "$ref": "#/$defs/result" },
        "architraveFootZ": { "$ref": "#/$defs/result" }
      }
    },
    "eastCeiling": {
      "type": "object",
      "description": "Plafond du ptéron est et corniche des fronts des porches (README section 7.11) : poutres (nombre, pas, largeur, hauteur, bout ouest), massif de bout, corniche à anthémion et bandeau (hauteurs, saillie, profondeur), caissons (pas, ouverture, cadre, profondeur, rangs par travée). Demande le bloc `porchExtension`.",
      "additionalProperties": false,
      "required": ["beamCount", "beamSpacing", "beamWidth", "beamHeight", "beamWestBearing", "endMassifWidth", "corniceHeight", "corniceProjection", "bandHeight", "corniceDepth", "cofferPitch", "cofferOpening", "cofferFrame", "cofferDepth", "cofferRows"],
      "properties": {
        "beamCount":         { "$ref": "#/$defs/count" },
        "beamSpacing":       { "$ref": "#/$defs/length" },
        "beamWidth":         { "$ref": "#/$defs/length" },
        "beamHeight":        { "$ref": "#/$defs/length" },
        "beamWestBearing":   { "$ref": "#/$defs/length" },
        "endMassifWidth":    { "$ref": "#/$defs/length" },
        "corniceHeight":     { "$ref": "#/$defs/length" },
        "corniceProjection": { "$ref": "#/$defs/length" },
        "bandHeight":        { "$ref": "#/$defs/length" },
        "corniceDepth":      { "$ref": "#/$defs/length" },
        "cofferPitch":       { "$ref": "#/$defs/length" },
        "cofferOpening":     { "$ref": "#/$defs/length" },
        "cofferFrame":       { "$ref": "#/$defs/length" },
        "cofferDepth":       { "$ref": "#/$defs/length" },
        "cofferRows":        { "$ref": "#/$defs/count" }
      }
    },
    "eastCeilingControls": {
      "type": "object",
      "description": "Contrôles du plafond est (README section 7.11, règle R13 du script), en mètres, sans statut.",
      "additionalProperties": false,
      "required": ["beamOuterAxisY", "beamBottomZ", "beamTopZ", "beamWestEndX", "beamEastEndX", "beamLength", "clearBay", "massifFaceY", "edgeBay", "corniceTopZ", "bandTopZ", "slabThickness", "cofferFloor", "cofferRun", "cofferMargin"],
      "properties": {
        "beamOuterAxisY": { "$ref": "#/$defs/result" },
        "beamBottomZ":    { "$ref": "#/$defs/result" },
        "beamTopZ":       { "$ref": "#/$defs/result" },
        "beamWestEndX":   { "$ref": "#/$defs/result" },
        "beamEastEndX":   { "$ref": "#/$defs/result" },
        "beamLength":     { "$ref": "#/$defs/result" },
        "clearBay":       { "$ref": "#/$defs/result" },
        "massifFaceY":    { "$ref": "#/$defs/result" },
        "edgeBay":        { "$ref": "#/$defs/result" },
        "corniceTopZ":    { "$ref": "#/$defs/result" },
        "bandTopZ":       { "$ref": "#/$defs/result" },
        "slabThickness":  { "$ref": "#/$defs/result" },
        "cofferFloor":    { "$ref": "#/$defs/result" },
        "cofferRun":      { "$ref": "#/$defs/result" },
        "cofferMargin":   { "$ref": "#/$defs/result" }
      }
    },
    "flankCeilings": {
      "type": "object",
      "description": "Plafonds des ptérons nord et sud (README section 7.11) : poutres transversales (pas, premier axe, nombres à l'est et à l'ouest, section, bout côté péristyle), rangs de caissons. Demande le bloc `eastCeiling`.",
      "additionalProperties": false,
      "required": ["beamSpacing", "firstBeamOffset", "eastBeamCount", "westBeamCount", "beamWidth", "beamHeight", "peristyleGap", "cofferRows"],
      "properties": {
        "beamSpacing":     { "$ref": "#/$defs/length" },
        "firstBeamOffset": { "$ref": "#/$defs/length" },
        "eastBeamCount":   { "$ref": "#/$defs/count" },
        "westBeamCount":   { "$ref": "#/$defs/count" },
        "beamWidth":       { "$ref": "#/$defs/length" },
        "beamHeight":      { "$ref": "#/$defs/length" },
        "peristyleGap":    { "$ref": "#/$defs/length" },
        "cofferRows":      { "$ref": "#/$defs/count" }
      }
    },
    "flankCeilingsControls": {
      "type": "object",
      "description": "Contrôles des plafonds des flancs (README section 7.11, règle R13 du script), en mètres, sans statut.",
      "additionalProperties": false,
      "required": ["lastEastAxisX", "lastWestAxisX", "wallEndY", "peristyleEndY", "beamLength", "cofferRun", "cofferMargin"],
      "properties": {
        "lastEastAxisX": { "$ref": "#/$defs/result" },
        "lastWestAxisX": { "$ref": "#/$defs/result" },
        "wallEndY":      { "$ref": "#/$defs/result" },
        "peristyleEndY": { "$ref": "#/$defs/result" },
        "beamLength":    { "$ref": "#/$defs/result" },
        "cofferRun":     { "$ref": "#/$defs/result" },
        "cofferMargin":  { "$ref": "#/$defs/result" }
      }
    }
  },
  "$defs": {
    "status":     { "type": "string", "enum": ["lu", "déduit", "mesuré", "convention", "manquant"] },
    "lengthUnit": { "type": "string", "enum": ["m", "in", "mm", "ft"], "description": "Unité telle qu'écrite dans le README, pieds décimaux compris ; 1 in = 0,0254 m, 1 ft = 12 in = 0,3048 m (README l. 31). Le lecteur convertit en mètres." },
    "sources":    { "type": "array", "items": { "type": "string" } },
    "readme":     { "type": "string", "description": "Lieu de la valeur dans le README : « §3.2, l. 74 »." },
    "length": {
      "description": "Longueur : un nombre dans une unité de `lengthUnit`, ou une cote en pieds et pouces (`feetAndInches`).",
      "oneOf": [{ "$ref": "#/$defs/scalarLength" }, { "$ref": "#/$defs/feetAndInches" }]
    },
    "scalarLength": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "status", "sources", "readme"],
      "properties": {
        "value":   { "type": "number", "exclusiveMinimum": 0 },
        "unit":    { "$ref": "#/$defs/lengthUnit" },
        "status":  { "$ref": "#/$defs/status" },
        "sources": { "$ref": "#/$defs/sources" },
        "readme":  { "$ref": "#/$defs/readme" }
      }
    },
    "angle": {
      "type": "object",
      "description": "Angle en degrés, unité « ° » collée au nombre dans le README (règle R9).",
      "additionalProperties": false,
      "required": ["unit", "status", "sources", "readme"],
      "properties": {
        "value":   { "type": "number", "exclusiveMinimum": 0 },
        "unit":    { "const": "°" },
        "status":  { "$ref": "#/$defs/status" },
        "sources": { "$ref": "#/$defs/sources" },
        "readme":  { "$ref": "#/$defs/readme" }
      }
    },
    "ratio": {
      "type": "object",
      "description": "Rapport « 1 : nombre » du README (règle R12) : le nombre de droite, réel > 0.",
      "additionalProperties": false,
      "required": ["unit", "status", "sources", "readme"],
      "properties": {
        "value":   { "type": "number", "exclusiveMinimum": 0 },
        "unit":    { "const": "ratio" },
        "status":  { "$ref": "#/$defs/status" },
        "sources": { "$ref": "#/$defs/sources" },
        "readme":  { "$ref": "#/$defs/readme" }
      }
    },
    "feetAndInches": {
      "type": "object",
      "description": "Cote en pieds et pouces (règle R6), une seule valeur : [pieds, pouces], pieds entiers >= 1, pouces finis >= 0 ; (pieds × 12 + pouces) × 0,0254 m.",
      "additionalProperties": false,
      "required": ["unit", "status", "sources", "readme"],
      "properties": {
        "value":   {
          "type": "array",
          "prefixItems": [{ "type": "integer", "exclusiveMinimum": 0 }, { "type": "number", "minimum": 0 }],
          "minItems": 2,
          "maxItems": 2
        },
        "unit":    { "const": "ft+in" },
        "status":  { "$ref": "#/$defs/status" },
        "sources": { "$ref": "#/$defs/sources" },
        "readme":  { "$ref": "#/$defs/readme" }
      }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "status", "sources", "readme"],
      "properties": {
        "value":   { "type": "integer", "exclusiveMinimum": 0 },
        "unit":    { "const": "1" },
        "status":  { "$ref": "#/$defs/status" },
        "sources": { "$ref": "#/$defs/sources" },
        "readme":  { "$ref": "#/$defs/readme" }
      }
    },
    "divisions": {
      "type": "object",
      "description": "Suite de largeurs de gauche à droite, chacune avec le mot du README qui la précède.",
      "additionalProperties": false,
      "required": ["values", "kinds", "unit", "status", "sources", "readme"],
      "properties": {
        "values":  { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
        "kinds":   { "type": "array", "items": { "type": "string", "enum": ["demi-canal", "bande", "canal"] } },
        "unit":    { "$ref": "#/$defs/lengthUnit" },
        "status":  { "$ref": "#/$defs/status" },
        "sources": { "$ref": "#/$defs/sources" },
        "readme":  { "$ref": "#/$defs/readme" }
      }
    },
    "rakingHeights": {
      "type": "object",
      "description": "Suite de hauteurs de membres, de haut en bas, chacune avec le mot du README qui la précède.",
      "additionalProperties": false,
      "required": ["values", "kinds", "unit", "status", "sources", "readme"],
      "properties": {
        "values":  { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
        "kinds":   { "type": "array", "items": { "type": "string", "enum": ["listel", "filet", "larmier", "gorge de la sous-face (bec)"] } },
        "unit":    { "$ref": "#/$defs/lengthUnit" },
        "status":  { "$ref": "#/$defs/status" },
        "sources": { "$ref": "#/$defs/sources" },
        "readme":  { "$ref": "#/$defs/readme" }
      }
    },
    "polygon": {
      "type": "object",
      "description": "Polygone fermé, sommets dans l'ordre du README (règle R11) : u et h de même rang forment un sommet.",
      "additionalProperties": false,
      "required": ["u", "h", "unit", "status", "sources", "readme"],
      "properties": {
        "u":       { "type": "array", "items": { "type": "number" } },
        "h":       { "type": "array", "items": { "type": "number" } },
        "unit":    { "$ref": "#/$defs/lengthUnit" },
        "status":  { "$ref": "#/$defs/status" },
        "sources": { "$ref": "#/$defs/sources" },
        "readme":  { "$ref": "#/$defs/readme" }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "readme"],
      "properties": {
        "values": { "type": "array", "items": { "type": "number" } },
        "readme": { "$ref": "#/$defs/readme" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "readme"],
      "properties": {
        "value":  { "type": "number" },
        "readme": { "$ref": "#/$defs/readme" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "readme"],
      "properties": {
        "value":  { "type": "number", "exclusiveMinimum": 0 },
        "unit":   { "$ref": "#/$defs/lengthUnit" },
        "readme": { "$ref": "#/$defs/readme" }
      }
    },
    "angleControl": {
      "type": "object",
      "description": "Contrôle d'angle en degrés, unité « ° » collée au nombre dans le README (règle R9).",
      "additionalProperties": false,
      "required": ["value", "unit", "readme"],
      "properties": {
        "value":  { "type": "number", "exclusiveMinimum": 0 },
        "unit":   { "const": "°" },
        "readme": { "$ref": "#/$defs/readme" }
      }
    },
    "countControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "readme"],
      "properties": {
        "value":  { "type": "integer", "exclusiveMinimum": 0 },
        "unit":   { "const": "1" },
        "readme": { "$ref": "#/$defs/readme" }
      }
    },
    "profile": {
      "type": "object",
      "description": "Points d'un profil : profondeur sous le lit de l'abaque et retrait depuis son nu, de haut en bas.",
      "additionalProperties": false,
      "required": ["depths", "retreats", "unit", "readme"],
      "properties": {
        "depths":   { "type": "array", "items": { "type": "number" } },
        "retreats": { "type": "array", "items": { "type": "number" } },
        "unit":     { "$ref": "#/$defs/lengthUnit" },
        "readme":   { "$ref": "#/$defs/readme" }
      }
    }
  }
}
